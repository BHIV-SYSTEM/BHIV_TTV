# ==============================================================================
# UNIFIED TEXT-TO-VIDEO (TTV) SYSTEM CONFIGURATION
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
LOG_LEVEL=INFO

# Security & Governance (From ttv7, ttv11, Text_to_vision2)
GOVERNANCE_LOCK=ON
WRAPPER_TOKEN=TTV_SECURE_GOVERNED_TOKEN_2026

# Provider Selection (Options: openai | gemini | local)
LLM_PROVIDER=local

# Image Generation Provider (Options: openai | local)
IMAGE_PROVIDER=local

# Video Generation Engine (Options: opencv | external | wan | cogvideox)
# opencv    — local cinematic engine, no GPU required (default/safe)
# external  — falls back to opencv
# wan       — Wan 2.2 TI2V-5B on cloud NVIDIA GPU (requires CUDA)
# cogvideox — CogVideoX-2B text-to-video foundation model (requires CUDA, ≥10GB VRAM)
VIDEO_PROVIDER=cogvideox

# ── CogVideoX-2B Video Generation (NVIDIA GPU with CUDA) ─────────────────────
# Prerequisites:
#   1. NVIDIA GPU with CUDA (≥10GB VRAM with CPU offload, e.g. RTX 3080)
#   2. diffusers>=0.33.0, transformers, accelerate, torch with CUDA
#
# COGVIDEOX_MODEL_ID=THUDM/CogVideoX-2b
# COGVIDEOX_DEVICE=cuda
# COGVIDEOX_DTYPE=bfloat16           # bfloat16 | float16
# COGVIDEOX_CPU_OFFLOAD=true         # Enables model CPU offload for 10GB VRAM cards
# COGVIDEOX_SEQUENTIAL_CPU_OFFLOAD=false
# COGVIDEOX_ENABLE_TILING=true       # Enables VAE tiling to minimize peak VRAM
# COGVIDEOX_ENABLE_SLICING=true      # Enables VAE slicing to minimize peak VRAM
# COGVIDEOX_NUM_FRAMES=49            # Frames generated per clip (CogVideoX standard is 49)
# COGVIDEOX_NUM_INFERENCE_STEPS=30   # Inference steps (30-50 recommended)
# COGVIDEOX_GUIDANCE_SCALE=6.0       # Classifier-free guidance scale
# COGVIDEOX_DEFAULT_WIDTH=720        # Default video width (720x480 standard)
# COGVIDEOX_DEFAULT_HEIGHT=480       # Default video height
# COGVIDEOX_LORA_PATH=               # Optional trained LoRA checkpoint path
# COGVIDEOX_LORA_SCALE=1.0

# ── Wan 2.2 TI2V-5B Video Generation (cloud NVIDIA GPU only) ─────────────────
# Prerequisites:
#   1. NVIDIA GPU with CUDA (≥16GB VRAM for 480p, ≥24GB for 720p)
#   2. Install torch for your CUDA version: https://pytorch.org/get-started/locally/
#   3. pip install diffusers>=0.33.0 transformers>=4.51.0 accelerate>=1.6.0
#
# WAN_MODEL_ID=Wan-AI/Wan2.2-TI2V-5B-Diffusers
# WAN_DEVICE=cuda
# WAN_DTYPE=bfloat16           # bfloat16 (A100/H100) | float16 (T4/V100)
# WAN_NUM_FRAMES=81            # Frames Wan generates per clip
# WAN_INFERENCE_STEPS=30       # Diffusion steps (higher = better quality, slower)
# WAN_GUIDANCE_SCALE=5.0       # CFG scale
# MODEL_MODE=wan_lora           # base | wan_lora | finetuned (legacy research model)
# WAN_LORA_PATH=models/experiments/ttv_wan_lora_v001
# WAN_LORA_SCALE=1.0
# HF_TOKEN=                    # HuggingFace token if model access is gated

# Keep disabled until a semantic VLM evaluator is configured.
PROMPT_ADHERENCE_PROVIDER=disabled
MAX_VIDEO_RETRIES=2


# Text-to-Speech Provider (Options: auto | edge | google | xtts | elevenlabs | azure | local)
TTS_PROVIDER=auto

# Visual Consistency & Style Engine (Options: standard | enhanced)
VISION_PROVIDER=standard

# API Keys (Optional - required only if cloud providers are enabled)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Storage Paths
OUTPUT_DIR=generated/videos
TEMP_DIR=generated/temp
IMAGES_DIR=generated/images
SCENES_DIR=generated/scenes
AUDIO_DIR=generated/audio

REFERENCES_DIR=generated/references

# Generation Defaults
DEFAULT_DURATION=15
MAX_DURATION=60
DEFAULT_FPS=24
DEFAULT_RESOLUTION=1280x720
DEFAULT_STYLE=cinematic
DEFAULT_VOICE=en-US-GuyNeural
DEFAULT_ASPECT_RATIO=16:9
DEFAULT_QUALITY=standard
DEFAULT_LANGUAGE=en-IN

# Dataset lifecycle (ingestion/LoRA are separate from normal generation)
DATASET_STORAGE=./data
DATASET_MAX_DOWNLOAD_GB=100
ENABLE_DATASET_TRAINING=false

# Real-time enrichment is opt-in. Set an authenticated, approved provider URL;
# unavailable or malformed responses are never represented as current facts.
ENABLE_REALTIME_DATA=false
REALTIME_DATA_URL=
REALTIME_DATA_TIMEOUT=10

# Reference retrieval (HTTP/HTTPS only, SSRF-protected)
REFERENCE_MAX_BYTES=104857600
REFERENCE_DOWNLOAD_TIMEOUT=30

# Hardware & FFmpeg Configuration
# Explicit path to ffmpeg executable (optional, auto-detected if empty)
FFMPEG_PATH=
# CUDA device selection
CUDA_VISIBLE_DEVICES=0
DEFAULT_GPU_INDEX=0

# Lip-sync (viseme is local/offline; wav2lip needs a checkpoint)
LIPSYNC_ENABLED=true
LIPSYNC_PROVIDER=musetalk
# LIPSYNC_MODEL_PATH=models/wav2lip/wav2lip.pth
# MUSETALK_CHECKPOINT_PATH=models/musetalk

# Audio Mixing Defaults
BACKGROUND_MUSIC_ENABLED=true
AUDIO_DUCKING_RATIO=0.3
AUDIO_SAMPLE_RATE=44100
